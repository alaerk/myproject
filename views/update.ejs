<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تعديل الملاحظة</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700&display=swap" rel="stylesheet">
<style>
  body{font-family:'Cairo',sans-serif; background:#f8f9fb;}
</style>
</head>
<body>

<!-- NAV موحد -->
<nav class="bg-white border-b sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-3 flex justify-between items-center">
    <a href="/" class="font-bold text-lg">📝 MyNotes</a>
    <div class="flex gap-6 text-sm items-center">
      <a href="/" class="text-gray-500">الرئيسية</a>
      <a href="/afficherAllnote" class="text-gray-500">ملاحظاتي</a>
      <a href="/create" class="text-gray-500">إنشاء</a>
      <a href="/note/<%= note._id %>" class="bg-black text-white px-5 py-2 rounded-full">رجوع للتفاصيل</a>
    </div>
  </div>
</nav>

<div class="max-w-2xl mx-auto px-6 py-10">

  <h1 class="text-2xl font-bold">تعديل الملاحظة ✏️</h1>
  <p class="text-sm text-gray-500 mt-1">    غير ما تريد و اضغط على حفظ</p>

  <form class="bg-white border rounded-[24px] p-7 mt-6 space-y-5 shadow-sm">

    <div>
      <label class="text-sm font-bold">العنوان</label>
      <input name="title" value="<%= note.title %>" class="w-full mt-2 border rounded-xl px-4 py-3 outline-none focus:border-black" placeholder="عنوان الملاحظة" required>
    </div>

    <div>
      <label class="text-sm font-bold">التصنيف</label>
      <select name="tag" class="w-full mt-2 border rounded-xl px-4 py-3 bg-white outline-none focus:border-black">
        <option >Study</option>
        <option >Work</option>
        <option >Personnal</option>
        <option >Another</option>
      </select>
    </div>

    <div>
      <label class="text-sm font-bold">المحتوى</label>
      <textarea name="content" rows="8" class="w-full mt-2 border rounded-xl px-4 py-3 outline-none focus:border-black leading-7" placeholder="اكتب المحتوى هنا..." required><%= note.content %></textarea>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="flex-1 bg-black text-white py-3 rounded-xl font-bold hover:bg-zinc-800">حفظ التعديلات</button>
      <a href="/note/<%= note._id %>" class="flex-1 text-center bg-white border py-3 rounded-xl font-bold">إلغاء</a>
    </div>

  </form>

  <script>
    const form = document.querySelector('form');
    form.addEventListener('submit', async(e)=>{
      e.preventDefault();
      fetch('/updates/<%= note._id %>', {
        method: 'PUT',
        body: JSON.stringify({
          title: form.elements['title'].value,
          tag: form.elements['tag'].value,
          content: form.elements['content'].value
        }),
        headers: {'Content-Type':'application/json'}
      }).then(res=>res.json())
      .then(data=>location.assign(`/note/${data.note._id}`))
      .catch(err=>{
        console.log(err.message);
      })
    });
  </script>

</div>

</body>
</html