<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-white">
<nav class="border-b px-6 py-3 flex justify-between max-w-6xl mx-auto">
  <a href="/" class="font-bold">📝 MyNotes</a>
  <div class="flex gap-4 text-sm"><a href="/">Home</a><a href="/login">Log in</a><a href="/signup" class="font-bold">Sign up</a></div>
</nav>
<div class="min-h-[80vh] flex items-center justify-center">
  <form id="regForm" class="w-full max-w-sm space-y-4">
    <h1 class="text-3xl font-bold text-center">حساب جديد ✨</h1>
    <input name="name" placeholder="الاسم" class="w-full border rounded-2xl px-4 py-3" required>
    <input name="email" placeholder="الإيميل" class="w-full border rounded-2xl px-4 py-3" required>
    <p class="errors email text-red-500 text-xs h-3"></p>

    <input name="password" type="password" placeholder="الباسورد" class="w-full border rounded-2xl px-4 py-3" required>
    <p class="errors password text-red-500 text-xs h-3"></p>
    <button class="w-full bg-black text-white py-3 rounded-2xl font-bold">إنشاء</button>
  </form>
</div>
<script>
const form=document.getElementById('regForm');
form.addEventListener('submit', async(e)=>{
  e.preventDefault();
  const emailError=document.querySelector('.errors.email');
  const passError=document.querySelector('.errors.password');
  emailError.textContent=''; 
  passError.textContent='';
  fetch('/signup',
  {method:'POST',
  body:JSON.stringify({name:form.name.value,email:form.email.value,password:form.password.value}),
  headers:{'Content-Type':'application/json'}
  })
  .then((res)=>{
    return res.json();
  })
  .then((data)=>{
      location.assign('/home');
  })
  .catch(err=>{
      emailError.textContent=err.email; 
  passError.textContent=err.password;
  })
  // const res=await ;
  // const data=await res.json();
    
  // if(!res.ok){ 
  //   emailError.textContent=data.message||data.errors?.email||'خطأ'; 
  //   passError.textContent=data.errors?.password||''; 
  //   return;
  // }
  // location.assign('/');
});
</script>
</body>
</html>
