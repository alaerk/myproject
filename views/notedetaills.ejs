<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-[#f8f9fb]">
<nav class="bg-white border-b px-6 py-3 flex justify-between max-w-6xl mx-auto">
  <a href="/afficherAllnote" class="text-sm">← كل الملاحظات</a>
  <div class="flex gap-2">
    <a href="/update/<%= note._id %>" class="text-sm border px-4 py-1.5 rounded-full">تعديل</a>
    <button onclick="if(confirm('متأكد؟')) fetch('/notes/<%= note._id %>',{method:'DELETE'}).then(()=>location.href='/afficherAllnote')" class="text-sm bg-red-500 text-white px-4 py-1.5 rounded-full">حذف</button>
  </div>
</nav>
<div class="max-w-2xl mx-auto p-6">
  <div class="bg-white border rounded-[24px] p-8 shadow-sm">
    <span class="bg-black text-white text-xs px-3 py-1 rounded-full"><%= note.tag %></span>
    <h1 class="text-3xl font-bold mt-4 leading-tight"><%= note.title %></h1>
    <p class="text-xs text-gray-400 mt-3"><%= note.createdAt.toLocaleString() %></p>
    <hr class="my-6">
    <p class="leading-9 text-gray-800 whitespace-pre-line text-[15px]"><%= note.content %></p>
  </div>
</div>
</body></html>